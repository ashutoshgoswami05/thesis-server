# Tunables for the official-image Ceph stack. The all-in-one image took a
# larger set of variables (OSD_COUNT, ENABLE_DASHBOARD, ENABLE_RBD and so on)
# because its own entrypoint read them; the official image has no entrypoint,
# so these are read by infra/ceph/entrypoint.sh instead.
#
# No S3 credentials here. The driver scripts create the thesisuser account
# with radosgw-admin once the stack is healthy, which is where that user was
# always created.

# Size of the file BlueStore uses as its block device. The all-in-one stack
# ran a 10G OSD and filled it inside a campaign, which is why the drivers run
# radosgw-admin gc and abort at 85%. 20G on this 75 GB host leaves that headroom
# without crowding the other five backends' volumes.
OSD_SIZE=20G

# One OSD cannot hold Ceph's default three replicas, and a pool that cannot
# reach its replica count stops accepting writes. Raising this needs more
# OSDs, which means more ceph-osd services in docker-compose.yml.
POOL_SIZE=1

RGW_PORT=8000
