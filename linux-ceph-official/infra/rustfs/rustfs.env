RUSTFS_ACCESS_KEY=thesisaccesskey
RUSTFS_SECRET_KEY=thesissecretkey1234
# Base64-encoded 32-byte key enabling SSE-S3. Without it RustFS returns
# "SSE-S3 requires RUSTFS_SSE_S3_MASTER_KEY to be set..." -- so the earlier
# sse_s3=False result measured this deployment's configuration, not a
# missing feature. Set here so the capability is measured on its merits.
RUSTFS_SSE_S3_MASTER_KEY=VFcqBZh/fe66ocwGt4R/yWhxKotsxho4bhfXXsJUATE=
